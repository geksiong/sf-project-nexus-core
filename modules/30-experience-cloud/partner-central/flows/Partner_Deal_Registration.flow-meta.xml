<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Validation, channel conflict check, routing to the channel manager and approval are done by DealRegistrationService via the uniform result envelope.</description>
        <name>Submit_Deal_Registration</name>
        <label>Submit Deal Registration</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>SubmitDealRegistrationAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Registration_Succeeded</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customerCompany</name>
            <value>
                <elementReference>Customer_Company</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>customerContactName</name>
            <value>
                <elementReference>Customer_Contact_Name</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>customerEmail</name>
            <value>
                <elementReference>Customer_Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>estimatedAmount</name>
            <value>
                <elementReference>Estimated_Amount</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>expectedCloseDate</name>
            <value>
                <elementReference>Expected_Close_Date</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>productInterest</name>
            <value>
                <elementReference>Product_Interest</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>varIsSuccess</assignToReference>
            <name>isSuccess</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varErrorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Registration_Succeeded</name>
        <label>Registration Succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Failed</defaultConnectorLabel>
        <rules>
            <name>Succeeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Success_Screen</targetReference>
            </connector>
            <label>Succeeded</label>
        </rules>
    </decisions>
    <description>Partner deal registration for Nexus Partner Central (Demo App 6): captures the deal and submits it through SubmitDealRegistrationAction, which routes it to the channel manager for approval.</description>
    <dynamicChoiceSets>
        <name>ProductInterestChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
        <object xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
        <picklistField>Product_Interest__c</picklistField>
        <picklistObject>Deal_Registration__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Partner Deal Registration {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Partner Deal Registration</label>
    <processMetadataValues>
        <name>BuilderType</name>
