{
  "orgName": "Nexus Core Full Scratch Org",
  "edition": "Developer",
  "features": [
    "EnableSetPasswordInApi",
    "Entitlements",
    "OmniStudioDesigner",
    "OmniStudioRuntime",
    "Communities",
    "Sites",
    "AnalyticsAdminPerms",
    "DevelopmentWave"
  ],
